# ─── SonhoEuropa · variáveis de ambiente ─────────────────────────────────────
# Copia para .env.local e preenche. NUNCA faças commit do .env.local
# (.gitignore já cobre .env*).

# ── Supabase ──
# URL do projecto e chave anónima. Ambas são públicas por design: vão no
# bundle do browser, que fala directamente com o Supabase. O que protege os
# dados NÃO é o segredo desta chave, são as políticas de RLS nas tabelas e as
# políticas dos buckets de Storage.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role. IGNORA O RLS POR COMPLETO.
# Só pode existir no servidor. Nunca lhe ponhas o prefixo NEXT_PUBLIC_ —
# isso publicava-a no browser e daria a qualquer visitante acesso total à
# base de dados. É usada em lib/supabase/admin.ts e serve também de segredo
# de assinatura das sessões de administrador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Administração ──
# Senha de acesso a /admin. Se SUPABASE_SERVICE_ROLE_KEY não estiver definida,
# é esta que assina as sessões de admin. Sem nenhuma das duas a aplicação
# recusa todas as sessões de administrador (falha fechada, de propósito).
ADMIN_PASSWORD=

# ── URL público ──
# Base usada nos redireccionamentos de OAuth. Sem isto é inferido do pedido.
NEXT_PUBLIC_SITE_URL=https://sonhoeuropa.co.mz
